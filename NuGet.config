<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Scoped to this repo. The user/machine-level LWTLibraries feed needs
         credentials this project does not require - it consumes only public
         packages - and an unauthenticated agent fails restore with a 401.
         Add the internal feed back here if an LWT package is ever needed. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
