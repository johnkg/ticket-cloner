<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes the .NET runtime alongside the app, so the target machine needs no
  .NET install at all. Measured cost: 107 MB, against 1.2 MB for the default
  framework-dependent publish.

  Node is NOT a target-machine dependency either way: the RestoreSpa/BuildSpa
  targets run npm on the BUILD machine and what ships is the static output in
  wwwroot.

  IIS is the exception worth knowing about - it still needs the ASP.NET Core
  Module from the Hosting Bundle, whatever this setting says, because that is
  the piece IIS itself uses to hand requests to the app.

  Opt in with:  dotnet publish src/TicketCloner.Api -p:PublishProfile=SelfContained -o ./publish
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
